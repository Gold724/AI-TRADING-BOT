nBlur={updateFixedLimitPrice}></FractionPriceInput>}\n            {!contract.fractionalPrice && (\n              <TextField\n                label='Limit Price'\n                fullWidth\n                required\n                variant='outlined'\n                size='small'\n                value={limitPrice || ''}\n                type='number'\n                InputProps={{ inputProps: { min: 0, step: contract.tickSize + '' } }}\n                onChange={(e) => setLimitPrice(e.target.value ? parseFloat(e.target.value) : null)}\n                onBlur={updateFixedLimitPrice}\n              />\n            )}\n          </Box>\n        )}\n        {orderType == OrderType.Stop && (\n          <Box sx={{ marginTop: '1em' }}>\n            {contract.fractionalPrice && <FractionPriceInput contract={contract} value={stopPrice} onChange={(e) => setStopPrice(e)} onBlur={updateFixedStopPrice}></FractionPriceInput>}\n            {!contract.fractionalPrice && (\n              <TextField\n                label='Stop Price'\n                fullWidth\n                required\n                variant='outlined'\n                size='small'\n                value={stopPrice || ''}\n                type='number'\n                InputProps={{ inputProps: { min: 0, step: contract.tickSize + '' } }}\n                onChange={(e) => setStopPrice(e.target.value ? parseFloat(e.target.value) : null)}\n                onBlur={updateFixedStopPrice}\n              />\n            )}\n          </Box>\n        )}\n        {orderType == OrderType.TrailingStop && (\n          <Box sx={{ marginTop: '1em' }}>\n            <TextField\n              label='Trail Distance (Ticks)'\n              fullWidth\n              required\n              size='small'\n              variant='outlined'\n              value={trailDistance || ''}\n              type='number'\n              InputProps={{ inputProps: { min: 1, max: 1000, step: 1 } }}\n              onChange={(e) => updateTrailDistance(e.target.value ? parseInt(e.target.value) : null)}\n            />\n          </Box>\n        )}\n\n        <Box style={{ marginTop: '1em' }}>\n          <TextField label='# of Contracts' fullWidth variant='outlined' size='small' value={orderAmount} type='number' InputProps={{ inputProps: { min: 1, step: '1' } }} onChange={(v) => onSetOrderAmount(parseInt(v.target.value) || 1)} />\n        </Box>\n        {orderType == OrderType.Market && (\n          <Box style={{ fontSize: customFontSize.fontSize }}>\n            <div className={styles.marketOrderPriceContainer}>\n              <div className={styles.marketOrderPriceContainerBB}>\n                Bid: <ContractPriceSpan contract={contract}>{quoteData?.bestBid ?? 0}</ContractPriceSpan>\n              </div>\n              <div style={{ display: 'block', marginLeft: 5, marginRight: 5 }}>\n                <div className={styles.marketOrderPriceContainerLP} style={{ color: showFlash, ...flashStyle }}>\n                  <ContractPriceSpan contract={contract}>{quoteData?.lastPrice ?? 0}</ContractPriceSpan>\n                </div>\n                <div className={styles.marketOrderPriceContainerSpread}>\n                  <ContractPriceSpan contract={contract}>{(quoteData?.bestAsk ?? 0) - (quoteData?.bestBid ?? 0)}</ContractPriceSpan>\n                </div>\n              </div>\n              <div className={styles.marketOrderPriceContainerBA}>\n                Ask: <ContractPriceSpan contract={contract}>{quoteData?.bestAsk ?? 0}</ContractPriceSpan>\n              </div>\n            </div>\n          </Box>\n        )}\n        <Box\n          style={{\n            justifyContent: 'center',\n            display: 'flex',\n            alignItems: 'center',\n            fontSize: customFontSize.fontSize\n          }}\n        >\n          <div\n            style={{\n              justifyContent: 'center',\n              display: 'block',\n              flexWrap: 'wrap',\n              alignItems: 'center',\n              textAlign: 'center',\n              margin: '0.25em 0'\n            }}\n          >\n            {activePosition && activePosition.positionSize != 0 && (\n              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center' }}>\n                <div style={{ marginRight: 10 }}>\n                  {activePosition.positionSize > 0 ? '+' + activePosition.positionSize : activePosition.positionSize} @ <ContractPriceSpan contract={contract}>{activePosition.averagePrice}</ContractPriceSpan>\n                </div>\n                <div style={{ marginRight: 10 }}>\n                  <span style={{ color: showPnl() < 0 ? '#bd3f3b' : '#43984d' }}>UP&L ${showPnl().toFixed(2)}</span>\n                </div>\n                <div style={{ marginRight: 10 }}>\n                  <StyledButton color='neutral' disabled={showPnl() < 0} onClick={breakEven} sx={{ padding: '2px 4px', margin: '4px', fontSize: '.9em', minWidth: 20 }}>\n                    B/E\n                  </StyledButton>\n                </div>\n              </div>\n            )}\n            {(!activePosition || activePosition.positionSize == 0) && <div>No Active Position</div>}\n          </div>\n        </Box>\n\n        <CommonOrderOptions\n          contract={contract}\n          onBuy={handleBuy}\n          onSell={handleSell}\n          setSize={onSetOrderAmount}\n          size={orderAmount}\n          priceText={priceText}\n          hideJoinButton={false}\n          disableBuySell={!canPlaceOrder}\n          hideCancelAll={true}\n          hideCancelOrders={false}\n          hideClosePosition={false}\n          hideFlattenAll={false}\n          hideReversePosition={true}\n          onAction={minimize}\n        />\n      </div>\n    </div>\n  );\n};\n\nexport default React.memo(MobileWebChartTrade);\n","import { UserContractModel } from '@/api/userApi';\nimport { useSymbol } from '@/contexts/SymbolContext';\nimport React, { useMemo, useState } from 'react';\n\nconst MobileContractKey = 'mobileContractProductId';\n\nexport interface IMobileContextContext {\n  mobileContract: UserContractModel;\n  setMobileContract: (contract: UserContractModel) => void;\n}\n\nexport interface IMobileContextProviderProps {\n  children: React.ReactNode;\n}\n\nexport const MobileContext = React.createContext<IMobileContextContext>({} as any);\n\nexport const useMobile = () => React.useContext(MobileContext);\n\nexport const MobileContextProvider: React.FC<IMobileContextProviderProps> = (props) => {\n  const symbols = useSymbol();\n  const [firstLoad, setFirstLoad] = useState(true);\n  const [contract, setContract] = React.useState<UserContractModel>(!!localStorage.getItem(MobileContractKey) ? symbols.getContractByProductId(localStorage.getItem(MobileContractKey) as string) : symbols.getDefaultContract());\n\n  const values = useMemo(() => {\n    const values: IMobileContextContext = {\n      mobileContract: contract,\n      setMobileContract: (contract: UserContractModel) => {\n        setContract(contract);\n        localStorage.setItem(MobileContractKey, contract.productId);\n      }\n    };\n\n    return values;\n  }, [contract, firstLoad, props.children]);\n\n  return useMemo(() => {\n    return <MobileContext.Provider value={values}>{props.children}</MobileContext.Provider>;\n  }, [values, props.children]);\n};\n","import { IChartWidgetApi, IChartingLibraryWidget, ResolutionString, Timezone, widget, TradingTerminalWidgetOptions, IActionVariant, ActionsFactory, ActionId, CustomIndicator, WatermarkContentData } from '@/charting_library';\nimport { QuotesProvider } from '../../../../datafeed/quotesProvider';\nimport { Requester } from 'datafeeds2/lib/requester';\nimport React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport { TopStepDataFeed } from '../../../../datafeed/datafeed';\nimport { useCqg } from '../../../../contexts/CqgContext';\nimport { formatContractPrice } from '../../../../helpers/formatter';\nimport { useSymbol } from '../../../../contexts/SymbolContext';\nimport { calculatePnl, OrderPromptType, useOrders } from '../../../../contexts/OrdersContext';\nimport { AuthorizationHeaders, useApi } from '../../../../contexts/ApiContext';\nimport config, { TradingPlatforms } from '../../../../config';\nimport { ChartsClient, OrderType, TradingAccountStatus, UserContractModel } from '../../../../api/userApi';\nimport { roundToNearestTick, roundToTickSize } from 'src/helpers/decimalHelper';\nimport { useTradingAccount } from '@/contexts/TradingAccountContext';\nimport { LinkedColor, useLinked } from '@/contexts/LinkedContext';\nimport { useSettings } from '@contexts/SettingsContext';\nimport { SaveLoadAdater as SaveLoadAdapter } from '@/views/trader/components/charts/saveLoadAdapter';\nimport LinkIndicator from '@/views/trader/components/charts/linkIndicator';\nimport { TsModal } from '@/components/modal';\nimport { Box, Stack } from '@mui/material';\nimport Heading, { HeadingSize } from '@/components/topstep/heading';\nimport { StyledButton } from '@/components/styledComponents';\nimport ChartSettings from '@/components/topstep/chartSettings';\nimport { ChartGroup, ChartInstanceData } from '@/views/trader/components/charts/chartTypes';\nimport ChartPosition from '@/views/trader/components/charts/chartPosition';\nimport ChartOrders from '@/views/trader/components/charts/chartOrders';\nimport ChartTradeExecutions from '@/views/trader/components/charts/chartTradeExecutions';\nimport HoagsIndicator, { HoagsLevels } from './hoagsIndicator';\nimport { StrapiHoagsModel, HoagsAttributes, Datum2 } from '@/api/dataApi';\nimport { useModal } from '@/contexts/ModalContext';\nimport ConfirmOrderModal from '@/components/topstep/confirmOrderModal';\nimport { useDeviceContext } from '@/contexts/DeviceContext';\nimport { QuoteData } from '@/models/quoteData';\nimport QuantityButtons from '@/components/topstep/quantityButtons';\nimport styles from './chart.module.scss';\nimport { ContractPriceSpan } from '@/components/numbers';\nimport MobileWebChartTrade from './mobileWebChartTrade';\nimport { useMobile } from '@/contexts/MobileContext';\nimport { TradingEnvironment } from '@/data/tradingEnvironment';\nimport { getHelpfulAxiosError, handleAxiosError } from '@/helpers/axiosHelper';\nimport { useMarketNotifications } from '@/contexts/marketNotificationsContext';\nimport { v4 as uuidv4 } from 'uuid';\nimport { get } from 'lodash';\nimport { toast } from 'react-toastify';\n\ninterface SubInfoDetails {\n  timer: NodeJS.Timeout;\n  lastQuote: number;\n  currentQuote: number;\n  callbacks: SubInfoCallback[];\n}\n\nconst ORDER_ADJUST_SIDE = 10;\ninterface SubInfoCallback {\n  symbolId: string;\n  callbackId: number;\n  guid: string;\n  callback: (data: any) => void;\n}\n\ninterface ChartState {\n  name: string;\n  layout: string;\n  charts: object[];\n  symbolLock: number;\n  intervalLock: number;\n  trackTimeLock: number;\n  dateRangeLock: number;\n  crosshairLock: number;\n  layoutsSizes: object;\n}\n\ninterface SubInfo {\n  symbolId: string;\n  callback: string;\n  subId: number;\n}\n\ninterface ChartProps {\n  tabData: {\n    layoutName: string;\n    onChanged: () => void;\n  };\n\n  layoutName?: string;\n  mobile?: boolean;\n}\n\nconst tradeAmounts = [1, 2, 3, 4, 5, 10, 15];\n\nconst Chart: React.FC<ChartProps> = (props): JSX.Element => {\n  // Global State //\n\n  const [chartGroups, setChartGroups] = useState<ChartGroup[]>([]);\n  const { quotesApi, historyApi, timeApi, marksApi, searchApi, configApi, symbolsApi, retryApiCall } = useApi();\n  const { customSettings, saveCustomSettings, showConfirmations } = useSettings();\n  const { tabData, layoutName } = props;\n  const apiContext = useApi();\n\n  const { getContractByProductName, getContractByProductId } = useSymbol();\n\n  const containerRef = useRef(null);\n  const [tvWidget, setTvWidget] = useState<IChartingLibraryWidget>(null);\n  const {\n    subscribeChartDatasource,\n    unsubscribeChartDatasource,\n    subscribeTradeLog,\n    unsubscribeTradeLog,\n    subscribeBars,\n    unsubscribeBars,\n    subscribeQuotesForSymbol,\n    unsubscribeQuotesForSymbol,\n    subscribeOnChartReconnect,\n    unsubscribeOnChartReconnect,\n    subscribeHoags,\n    unsubscribeHoags,\n    chartDatasource\n  } = useCqg();\n  const { activeTradingAccount, tradingEnvironment } = useTradingAccount();\n  const { nonSltpOrders: orders, placeOrderWithSymbol: placeOrder } = useOrders();\n  const isMounted = useRef(true);\n  const canTrade = useRef(true);\n  const [showLinkHelpModal, setShowLinkHelpModal] = useState(false);\n  const [isNewUser, setIsNewUser] = useState(customSettings.addedChartLink === undefined ? true : false);\n  const isNewUserRef = useRef(isNewUser);\n  const [showChartSettings, setShowChartSettings] = useState(false);\n  const { showModal, hideModal } = useModal();\n  const { mobileContract, setMobileContract } = useMobile();\n  const { isMobile } = useDeviceContext();\n  const [tabContract, setTabSymbol] = useState<UserContractModel | null>(null);\n  const { subscribeMarketNotifications, unsubscribeMarketNotifications } = useMarketNotifications();\n\n  // Unique lock id for subscriptions\n  const notificationLock = useRef<string>('chart-' + uuidv4());\n\n  // Desktop state //\n\n  const { links } = useLinked();\n  const linkedContext = useLinked();\n  const linksRef = useRef(links);\n  const [linkChanged, setLinkChanged] = useState<boolean>(false);\n\n  // Mobile state //\n\n  const [quoteData, setQuoteData] = useState<QuoteData>(undefined);\n  const appliedLastChart = useRef(false);\n  const { placeOrderWithSymbol } = useOrders();\n  const [orderAmount, setOrderAmount] = useState<number>(1);\n  const [showFlash, setShowFlash] = useState<string>();\n  const [prevLastPrice, setPrevLastPrice] = useState<number | null>(null); // Keep track of previous price\n  const [showSlideOut, setShowSlideOut] = useState<boolean>(false);\n  const { activePositions, editSltpAccount } = useOrders();\n\n  // Desktop Hooks //\n\n  const getContractByProductNameRef = useRef(getContractByProductName);\n  const getContractByProductIdRef = useRef(getContractByProductId);\n\n  const ogTitle = useRef(document.title);\n  const titlePriceRef = useRef<number>(null);\n  const titleChangeRef = useRef<number>(null);\n\n  useEffect(() => {\n    if (!tabContract) {\n      document.title = ogTitle.current;\n      return;\n    }\n\n    const symbol = tabContract.contractName;\n\n    document.title = symbol;\n\n    const productId = tabContract.productId;\n\n    const id = subscribeQuotesForSymbol(productId, (quote) => {\n      if (quote.lastPrice) {\n        titlePriceRef.current = quote.lastPrice;\n      }\n\n      if (quote.changePercent) {\n        titleChangeRef.current = quote.changePercent;\n      }\n\n      const isUp = titleChangeRef.current >= 0;\n      const arrow = isUp ? '▲ +' : '▼ ';\n      const dollarSign = () => (tabContract?.fractionalPrice ? '' : '$');\n\n      document.title = `${symbol} ${dollarSign()}${formatContractPrice(titlePriceRef.current, tabContract)} ${arrow}${((titleChangeRef.current ?? 0) * 100).toFixed(2)}%`;\n    });\n\n    return () => {\n      unsubscribeQuotesForSymbol(productId, id);\n      document.title = ogTitle.current;\n    };\n  }, [tabContract]);\n\n  useEffect(() => {\n    getContractByProductNameRef.current = getContractByProductName;\n    getContractByProductIdRef.current = getContractByProductId;\n  }, [getContractByProductName, getContractByProductId]);\n\n  useEffect(() => {\n    if (isMobile) return;\n\n    if (isNewUser) {\n      setIsNewUser(false);\n      saveCustomSettings({ addedChartLink: true });\n    }\n  }, [isNewUser, saveCustomSettings]);\n\n  useEffect(() => {\n    if (isMobile) return;\n\n    linksRef.current = links;\n\n    if (!topStepFeed.current) return;\n    if (!widgetRef.current) return;\n\n    topStepFeed.current.setLinksMap(links);\n\n    let changedCharts = [];\n\n    for (let i = 0; i < widgetRef.current.chartsCount(); i++) {\n      const chart = widgetRef.current.chart(i);\n      const colorStudy = chart.getAllStudies().find((y) => y.name === 'Color Link');\n      if (colorStudy) {\n        const study = chart.getStudyById(colorStudy.id);\n        const color = study.getInputValues()[0];\n        if (color) {\n          const colorValue = color.value as string;\n          const linkSymbol = Object.values(links).find((y) => y.text === colorValue);\n\n          if (study.isVisible() && linkSymbol && !!linkSymbol.symbol?.productName && linkSymbol.symbol?.productName !== chart.symbol()) {\n            changedCharts.push(chart);\n            chart.setSymbol(linkSymbol.symbol.productName);\n          }\n        }\n      }\n    }\n\n    if (linkChanged) setLinkChanged(false);\n\n    const linkKeys = Object.values(links);\n    for (const chartGroup of chartGroups) {\n      const linkText = chartGroup.symbol.substring(0, chartGroup.symbol.indexOf('/'));\n      if (linkText.length > 0) {\n        const link = linkKeys.filter((y) => y.text == linkText);\n        if (link.length > 0) {\n          if (chartGroup.actualSymbol != link[0].symbol.productId) {\n            chartGroup.actualSymbol = link[0].symbol.productId;\n            for (const chart of chartGroup.charts) {\n              if (changedCharts.includes(chart.chart)) continue;\n              chart.chart.setSymbol(link[0].text + link[0].symbol.productId);\n            }\n          }\n        }\n      }\n    }\n  }, [links, chartGroups, linkChanged]);\n\n  // Mobile Hooks //\n\n  useEffect(() => {\n    if (!isMobile) return;\n\n    if (!mobileContract) {\n      return;\n    }\n\n    let initialQuote = true;\n    const id = subscribeQuotesForSymbol(mobileContract.productId, (quote) => {\n      setQuoteData((prev) => {\n        if (initialQuote) {\n          initialQuote = false;\n        }\n        return {\n          ...prev,\n          ...quote\n        };\n      });\n    });\n\n    return () => {\n      setQuoteData(undefined);\n      unsubscribeQuotesForSymbol(mobileContract.productId, id);\n    };\n  }, [mobileContract]);\n\n  // Retrieve order amount from local storage\n  useEffect(() => {\n    if (!isMobile) return;\n\n    const savedOrderAmount = localStorage.getItem('mobile-order-amount');\n    if (savedOrderAmount) {\n      setOrderAmount(parseInt(savedOrderAmount));\n    }\n  }, []);\n\n  // Set order amount to local storage for persistence\n  useEffect(() => {\n    if (!isMobile) return;\n\n    localStorage.setItem('mobile-order-amount', orderAmount.toString());\n  }, [orderAmount]);\n\n  const quickBuy = async () => {\n    await placeOrderWithSymbol({\n      amount: orderAmount,\n      symbol: mobileContract.productId,\n      orderType: OrderPromptType.Buy,\n      type: OrderType.Market\n    });\n  };\n\n  const quickSell = async () => {\n    await placeOrderWithSymbol({\n      amount: orderAmount,\n      symbol: mobileContract.productId,\n      orderType: OrderPromptType.Sell,\n      type: OrderType.Market\n    });\n  };\n\n  const tradeEnabled = useMemo(() => {\n    return activeTradingAccount.isFollower !== true && (activeTradingAccount?.status === TradingAccountStatus.Active || activeTradingAccount?.status == TradingAccountStatus.Ineligible);\n  }, [activeTradingAccount.isFollower, activeTradingAccount?.status]);\n\n  const flashStyle = {\n    transition: 'color 0.1s ease-in-out'\n  };\n\n  const handleSlideOut = () => {\n    setShowSlideOut((prev) => !prev);\n  };\n\n  // Compare askPrice with the previous value and trigger flashing effect\n  useEffect(() => {\n    let timerId;\n\n    if (prevLastPrice !== null && quoteData?.bestAsk !== null && quoteData?.lastPrice != null) {\n      if (quoteData.lastPrice > prevLastPrice) {\n        timerId = setTimeout(() => {\n          setShowFlash('#43984d');\n          setTimeout(() => {\n            setShowFlash('');\n          }, 1000);\n        }, 0);\n      } else if (quoteData.lastPrice < prevLastPrice) {\n        timerId = setTimeout(() => {\n          setShowFlash('#bd3f3b');\n          setTimeout(() => {\n            setShowFlash('');\n          }, 1000);\n        }, 0);\n      }\n    }\n    if (quoteData?.lastPrice) setPrevLastPrice(quoteData.lastPrice);\n    return () => clearTimeout(timerId);\n  }, [quoteData?.lastPrice, quoteData?.bestAsk]);\n\n  const activePosition = useMemo(() => {\n    if (!mobileContract) return;\n    const activePosList = activePositions.filter((y) => y.symbolId == mobileContract.productId);\n    return activePosList.length > 0 ? activePosList[0] : null;\n  }, [activePositions, mobileContract]);\n\n  const showPnl = () => {\n    if (quoteData?.lastPrice === undefined) return 0;\n    return calculatePnl(activePosition.positionSize, activePosition.averagePrice, quoteData.lastPrice, mobileContract.pointValue);\n  };\n\n  const positionEntryPrice = useMemo(() => {\n    if (!activePosition) return 0;\n    return roundToNearestTick(activePosition.averagePrice, mobileContract);\n  }, [activePosition?.averagePrice, mobileContract]);\n\n  const breakEven = useCallback(() => {\n    if (activePosition) {\n      editSltpAccount(activePosition.id, activePosition.symbolName, activePosition.positionSize, OrderType.Stop, positionEntryPrice, activePosition.takeProfit).catch((e) => {\n        const errorMessage = getHelpfulAxiosError(e);\n        if (errorMessage) {\n          toast.error(errorMessage);\n        } else {\n          toast.error('Error setting break even.');\n        }\n      });\n    }\n  }, [activePosition, positionEntryPrice, activePosition?.id, activePosition?.takeProfit, activePosition?.positionSize]);\n\n  const handleSetContract = (symbol: UserContractModel) => {\n    if (tvWidget) {\n      const chart = tvWidget.activeChart();\n      if (chart) {\n        chart.setSymbol(symbol?.productName);\n      }\n    }\n  };\n\n  // Global Hooks //\n\n  useEffect(() => {\n    console.log('Reconnected to chart data. Requesting fresh bars.');\n\n    const onReconnectCallback = () => {\n      if (widgetRef.current) {\n        for (let i = 0; i < widgetRef.current.chartsCount(); i++) {\n          const chart = widgetRef.current.chart(i);\n          topStepFeed.current.resetCache(chart.symbol());\n        }\n        for (let i = 0; i < widgetRef.current.chartsCount(); i++) {\n          const chart = widgetRef.current.chart(i);\n          chart.resetData();\n        }\n      }\n    };\n    subscribeOnChartReconnect(onReconnectCallback);\n\n    return () => {\n      unsubscribeOnChartReconnect(onReconnectCallback);\n    };\n  }, []);\n\n  const hoagsData = useRef<StrapiHoagsModel>(null);\n\n  const getHoagsData = () => {\n    if (config.platform !== TradingPlatforms.TopstepX) return;\n\n    const handleHoagsUpdate = (data: StrapiHoagsModel) => {\n      if (data?.data) {\n        data.data = data.data.map((x) => {\n          const datum = Datum2.fromJS(x);\n          datum.attributes = HoagsAttributes.fromJS(x.attributes);\n          return datum;\n        });\n      }\n      hoagsData.current = data;\n    };\n\n    subscribeHoags(handleHoagsUpdate);\n\n    return () => {\n      unsubscribeHoags(handleHoagsUpdate);\n    };\n  };\n\n  // Load hoags data every 5 minutes\n  useEffect(() => {\n    if (config.platform !== TradingPlatforms.TopstepX) return;\n\n    getHoagsData();\n    const interval = setInterval(\n      () => {\n        getHoagsData();\n      },\n      1000 * 60 * 300\n    );\n    return () => clearInterval(interval);\n  }, []);\n\n  const getHoagsLevels = (symbol: string) => {\n    const data = hoagsData?.current?.data?.find((x) => x.attributes.symbol === symbol)?.attributes;\n    const hoagsLevels: HoagsLevels = {\n      LWH: data?.lastWeekHigh,\n      YH: data?.yesterdayHigh,\n      YVAH: data?.yesterdayVAH,\n      VPOC: data?.yesterdayVPOC,\n      S: data?.settlement,\n      YVAL: data?.yesterdayVAL,\n      YL: data?.yesterdayLow,\n      WKOL: data?.wkoLow,\n      WKOH: data?.wkoHigh,\n      LWL: data?.lastWe