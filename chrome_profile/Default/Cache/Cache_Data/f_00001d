    >\n        Are you sure you wish to close your position in {contract.productName} ({contract.contractName})?\n      </ConfirmModal>\n    );\n  }, [activePosition, contract, onAction, confirmation, closePosition]);\n\n  const onClosePositonClick = useCallback(async () => {\n    if (!activePosition) return;\n    onAction && onAction();\n    setClosePositionButtonOff(true);\n    closePosition(activePosition)\n      .catch((e) => {\n        logException(e, 'Error closing position');\n        const errorMessage = getHelpfulAxiosError(e);\n        if (errorMessage) {\n          toast.error(errorMessage);\n        } else {\n          toast.error('Failed to close position');\n        }\n      })\n      .finally(() => {\n        setTimeout(() => {\n          setClosePositionButtonOff(false);\n        }, 2000);\n      });\n  }, [confirmation, activePosition, closeCurrentPositionModal, onAction, closePosition]);\n\n  const flattenAllModal = useCallback(() => {\n    return (\n      <ConfirmModal\n        header='Flatten All Orders?'\n        onCancel={hideModal}\n        onConfirm={() => {\n          hideModal();\n          onAction && onAction();\n          closeAllPositions().catch((e) => {\n            const errorMessage = getHelpfulAxiosError(e);\n            logException(e, 'Error flattening all positions');\n            if (errorMessage) {\n              toast.error(errorMessage);\n            } else {\n              toast.error('Failed to flatten all positions');\n            }\n          });\n        }}\n      >\n        Are you sure you wish to flatten all orders?\n      </ConfirmModal>\n    );\n  }, [onAction, confirmation, closeAllPositions]);\n\n  const disableMessage = useMemo(() => {\n    if (!contract) return 'No contract selected';\n\n    const violationType = activeTradingAccount.activeViolation?.type;\n    if (activeTradingAccount.isFollower) {\n      return 'Trade Copier Follower Account - No Manual Trading Allowed';\n    }\n\n    if (activeTradingAccount