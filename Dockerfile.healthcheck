# AI Trading Sentinel - Health Check Service
FROM python:3.10-slim-bullseye

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r healthcheck && useradd -r -g healthcheck -m -d /app -s /bin/bash healthcheck

# Set working directory
WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir \
    requests \
    redis \
    psutil \
    docker \
    python-dotenv

# Copy health check script
COPY scripts/health_check.py ./health_check.py

# Set permissions
RUN chown -R healthcheck:healthcheck /app \
    && chmod +x /app/health_check.py

# Switch to non-root user
USER healthcheck

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
    CMD python -c "import requests; requests.get('http://backend:5000/health', timeout=10)" || exit 1

# Default command
CMD ["python", "health_check.py"]