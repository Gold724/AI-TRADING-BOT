{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "Prometheus",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Trading Alerts",
        "type": "dashboard",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{summary}}"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "title": "AI Trading Sentinel - Production Dashboard",
  "tags": ["trading", "sentinel", "production", "trae"],
  "style": "dark",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "System Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "CPU Usage",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 1},
      "targets": [{
        "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)",
        "legendFormat": "CPU Usage %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Memory Usage",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 1},
      "targets": [{
        "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})) * 100",
        "legendFormat": "Memory Usage %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 95}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Disk Usage",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 1},
      "targets": [{
        "expr": "(1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\",instance=~\"$instance\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\",instance=~\"$instance\"})) * 100",
        "legendFormat": "Disk Usage %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 90}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Bot Status",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "targets": [{
        "expr": "up{job=\"tradebot\"}",
        "legendFormat": "Bot Online"
      }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "OFFLINE", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "ONLINE", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Trading Performance",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
    {
      "id": 7,
      "title": "Trade Executions (1h)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 10},
      "targets": [{
        "expr": "increase(trades_executed_total[1h])",
        "legendFormat": "Trades"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "single", "fixedColor": "blue"}
        }
      }
    },
    {
      "id": 8,
      "title": "Success Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 10},
      "targets": [{
        "expr": "(trades_successful_total / trades_executed_total) * 100",
        "legendFormat": "Success %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 60},
              {"color": "green", "value": 80}
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "P&L (24h)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 10},
      "targets": [{
        "expr": "increase(profit_loss_total[24h])",
        "legendFormat": "P&L"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              {"color": "red", "value": -1000},
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Current Drawdown",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 10},
      "targets": [{
        "expr": "current_drawdown_percent",
        "legendFormat": "Drawdown %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "System Health",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
    },
    {
      "id": 12,
      "title": "Trade Execution Latency",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(trade_execution_duration_seconds_bucket[5m]))",
          "legendFormat": "50th percentile"
        },
        {
          "expr": "histogram_quantile(0.95, rate(trade_execution_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.99, rate(trade_execution_duration_seconds_bucket[5m]))",
          "legendFormat": "99th percentile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {"group": "A", "mode": "none"},
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {"type": "linear"},
            "hideFrom": {"legend": false, "tooltip": false, "vis": false},
            "thresholdsStyle": {"mode": "off"}
          },
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 2}
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "targets": [{
        "expr": "rate(errors_total[5m])",
        "legendFormat": "Errors/sec"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {"group": "A", "mode": "none"},
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {"type": "linear"},
            "hideFrom": {"legend": false, "tooltip": false, "vis": false},
            "thresholdsStyle": {"mode": "line"}
          },
          "color": {"mode": "single", "fixedColor": "red"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
}