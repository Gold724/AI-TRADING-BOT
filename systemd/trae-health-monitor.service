[Unit]
Description=AI Trading Sentinel - Health Monitor
After=network-online.target trae-backend.service trae-trading-bot.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ai-trading-sentinel
Environment=PATH=/opt/ai-trading-sentinel/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/ai-trading-sentinel

# Health monitoring script
ExecStart=/bin/bash -c 'cd /opt/ai-trading-sentinel && source venv/bin/activate && exec python monitor_trading_bot.py --interval 60 --auto-restart'

# Restart configuration
Restart=always
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=600

# Timeouts
TimeoutStartSec=30
TimeoutStopSec=15

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trae-health-monitor

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ai-trading-sentinel
ReadWritePaths=/tmp

# Resource limits
LimitNOFILE=1024
MemoryMax=512M
CPUQuota=50%

[Install]WantedBy=multi-user.target