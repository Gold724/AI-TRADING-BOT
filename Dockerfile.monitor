# AI Trading Sentinel - Monitoring Service
# TRAE-SentinelOps: 24/7 health monitoring and alerting system

FROM python:3.10-slim-bullseye

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -r monitor && useradd -r -g monitor -m -d /app -s /bin/bash monitor

# Set working directory
WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir \
    requests \
    redis \
    psutil \
    schedule \
    docker \
    email-validator \
    pydantic \
    python-dotenv

# Copy monitoring scripts
COPY scripts/monitor.py ./monitor.py
COPY scripts/health_check.py ./health_check.py
COPY scripts/alert_manager.py ./alert_manager.py

# Set permissions
RUN chown -R monitor:monitor /app \
    && chmod +x /app/*.py

# Switch to non-root user
USER monitor

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
    CMD python -c "import redis; r=redis.from_url('redis://redis:6379'); r.ping()" || exit 1

# Default command
CMD ["python", "monitor.py"]