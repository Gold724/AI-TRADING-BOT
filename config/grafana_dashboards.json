    {
      "dashboard": {
        "id": null,
        "title": "AI Trading Sentinel - System Resources",
        "tags": ["system", "resources"],
        "style": "dark",
        "timezone": "browser",
        "panels": [
          {
            "id": 1,
            "title": "CPU Usage by Core",
            "type": "timeseries",
            "targets": [
              {
                "expr": "100 - (avg by(cpu) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                "legendFormat": "CPU {{cpu}}"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 0,
              "y": 0
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "unit": "percent",
                "max": 100,
                "min": 0
              }
            }
          },
          {
            "id": 2,
            "title": "Memory Usage",
            "type": "timeseries",
            "targets": [
              {
                "expr": "node_memory_MemTotal_bytes",
                "legendFormat": "Total Memory"
              },
              {
                "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
                "legendFormat": "Used Memory"
              },
              {
                "expr": "node_memory_MemAvailable_bytes",
                "legendFormat": "Available Memory"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 12,
              "y": 0
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "unit": "bytes"
              }
            }
          },
          {
            "id": 3,
            "title": "Disk Usage",
            "type": "timeseries",
            "targets": [
              {
                "expr": "node_filesystem_size_bytes{fstype!=\"tmpfs\"}",
                "legendFormat": "{{mountpoint}} - Total"
              },
              {
                "expr": "node_filesystem_size_bytes{fstype!=\"tmpfs\"} - node_filesystem_avail_bytes{fstype!=\"tmpfs\"}",
                "legendFormat": "{{mountpoint}} - Used"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 0,
              "y": 8
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "unit": "bytes"
              }
            }
          },
          {
            "id": 4,
            "title": "Network Traffic",
            "type": "timeseries",
            "targets": [
              {
                "expr": "rate(node_network_receive_bytes_total[5m])",
                "legendFormat": "{{device}} - Receive"
              },
              {
                "expr": "rate(node_network_transmit_bytes_total[5m])",
                "legendFormat": "{{device}} - Transmit"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 12,
              "y": 8
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "unit": "Bps"
              }
            }
          },
          {
            "id": 5,
            "title": "Load Average",
            "type": "timeseries",
            "targets": [
              {
                "expr": "node_load1",
                "legendFormat": "1 minute"
              },
              {
                "expr": "node_load5",
                "legendFormat": "5 minutes"
              },
              {
                "expr": "node_load15",
                "legendFormat": "15 minutes"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 0,
              "y": 16
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                }
              }
            }
          },
          {
            "id": 6,
            "title": "Disk I/O",
            "type": "timeseries",
            "targets": [
              {
                "expr": "rate(node_disk_read_bytes_total[5m])",
                "legendFormat": "{{device}} - Read"
              },
              {
                "expr": "rate(node_disk_written_bytes_total[5m])",
                "legendFormat": "{{device}} - Write"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 12,
              "y": 16
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "unit": "Bps"
              }
            }
          }
        ],
        "time": {
          "from": "now-1h",
