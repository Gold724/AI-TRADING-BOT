# TradeBot Sentinel Advanced - Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE CREDENTIALS (REQUIRED)
# =============================================================================
BULENOX_USERNAME=your_username
BULENOX_PASSWORD=your_password

# =============================================================================
# ADVANCED AUTOMATION FEATURES
# =============================================================================
# Auto-execute detected trades immediately
AUTO_EXECUTE=True

# Run in simulation mode (replay historical trades without execution)
SIMULATION=False

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Telegram Bot Integration
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email Notifications (Optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=alerts@yourdomain.com

# =============================================================================
# RETRY AND TIMEOUT SETTINGS
# =============================================================================
# Maximum number of retries for element selection
MAX_RETRIES=3

# Delay between retries in milliseconds
RETRY_DELAY=2000

# Page load timeout in milliseconds
PAGE_TIMEOUT=30000

# =============================================================================
# BROWSER SETTINGS
# =============================================================================
# Run browser in headless mode (true/false)
HEADLESS=true

# Take screenshots on errors (true/false)
SCREENSHOT_ON_ERROR=true

# Browser viewport width
VIEWPORT_WIDTH=1920

# Browser viewport height
VIEWPORT_HEIGHT=1080

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose network logging
VERBOSE_NETWORK_LOGGING=true

# Maximum log file size in MB
MAX_LOG_FILE_SIZE=100

# Number of log files to keep
LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# TRADE DETECTION SETTINGS
# =============================================================================
# Additional URL patterns to detect trades (comma-separated)
CUSTOM_TRADE_URL_PATTERNS=/api/orders,/trading/execute,/market/trade

# Additional JSON keywords to detect trades (comma-separated)
CUSTOM_TRADE_KEYWORDS=position,leverage,stop_loss,take_profit

# Minimum confidence score for trade detection (0.0-1.0)
TRADE_DETECTION_CONFIDENCE=0.8

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================
# Maximum time to wait for trade confirmation (seconds)
TRADE_CONFIRMATION_TIMEOUT=30

# Number of retries for trade confirmation
TRADE_CONFIRMATION_RETRIES=5

# Delay between confirmation checks (seconds)
TRADE_CONFIRMATION_DELAY=2

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
# Monitor dashboard refresh interval (seconds)
MONITOR_REFRESH_INTERVAL=5

# Enable real-time trade alerts
REAL_TIME_ALERTS=true

# Maximum number of trades to display in monitor
MONITOR_MAX_TRADES=10

# =============================================================================
# HISTORICAL DATA SETTINGS
# =============================================================================
# Maximum number of historical trades to keep
MAX_HISTORICAL_TRADES=1000

# Automatically archive old trades (true/false)
AUTO_ARCHIVE_TRADES=true

# Archive trades older than X days
ARCHIVE_AFTER_DAYS=30
